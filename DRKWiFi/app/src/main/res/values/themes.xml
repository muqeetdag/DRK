<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DRKMUQEET" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorPrimaryContainer">@color/lime_dim</item>
        <item name="colorOnPrimaryContainer">@color/lime</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/panel</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/red</item>
        <item name="colorOnError">@color/ink</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Eyebrow">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/lime</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MetricLabel">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MetricValue">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
