<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base folder: DeviceDefault.NoActionBar exists on every API level, so a
         ROM that lacks Theme.Material can still inflate the activity. -->
    <style name="Nyx" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/nyx_void</item>
        <item name="android:colorBackground">@color/nyx_void</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Nyx.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/nyx_dialog_bg</item>
    </style>
</resources>
