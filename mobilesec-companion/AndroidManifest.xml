<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.drkmuqeet.mobilesec">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="DRK MobileSec" android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="true" android:allowBackup="false" android:icon="@drawable/icon">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
