<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No storage permission: ACTION_GET_CONTENT (SAF) grants per-URI access.
         INTERNET is used ONLY by the built-in Google Maps preview (v1.2+);
         all EXIF extraction itself still happens on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Lets us probe for Google Maps before launching the geo: intent -->
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DRK">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>
    </application>
</manifest>
